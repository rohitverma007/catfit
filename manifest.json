{
  "name": "CatFit - Free Fitness Tracker",
  "short_name": "CatFit",
  "description": "Free fitness tracker app to count calories, log workouts, track weight loss goals, and monitor triathlon training. Works offline with no account required.",
  "start_url": "./index.html",
  "scope": "./",
  "id": "catfit-fitness-tracker",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#000000",
  "theme_color": "#9333ea",
  "orientation": "portrait",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["fitness", "health", "lifestyle", "sports"],
  "iarc_rating_id": "",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [],
  "shortcuts": [
    {
      "name": "Log Meal",
      "short_name": "Meal",
      "description": "Quickly log a meal and track calories",
      "url": "./index.html?tab=cal",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Log Workout",
      "short_name": "Workout",
      "description": "Log your gym workout session",
      "url": "./index.html?tab=gym",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Track Weight",
      "short_name": "Weight",
      "description": "Record your current weight",
      "url": "./index.html?tab=weight",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Analytics",
      "short_name": "Analytics",
